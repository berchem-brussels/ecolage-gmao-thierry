# Noms des variables seulement. Le fichier .env se crée sur le serveur par la commande des notes de livraison.
APP_NAME=
HTTPS_PORT=
HTTP_PORT=
PUBLIC_HOST=
JWT_SECRET=
CONFIG_ENC_KEY=
# 1 sur une installation d'acceptance seulement : autorise la commande des comptes de démonstration.
DEMO_ALLOWED=
